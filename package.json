{
  "name": "veloce",
  "version": "0.0.0",
  "private": true,
  "description": "AI-first, open-source presentation engine. AI agents build animated decks over MCP; humans edit the same deck by hand.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "tsc -b --clean",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build:editor": "pnpm --filter @veloce/editor build",
    "start": "pnpm build && pnpm build:editor && node apps/server/dist/cli.js --dir ./decks",
    "dev:server": "pnpm build && node apps/server/dist/cli.js --dir ./decks --allow-origin http://localhost:5173",
    "dev:editor": "pnpm --filter @veloce/editor dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "@veloce/builtins": "workspace:*",
    "@veloce/core": "workspace:*",
    "@veloce/doc-server": "workspace:*",
    "@veloce/format": "workspace:*",
    "@veloce/mcp": "workspace:*",
    "@veloce/plugin-api": "workspace:*",
    "@veloce/plugin-image": "workspace:*",
    "@veloce/plugin-shape": "workspace:*",
    "@veloce/plugin-text": "workspace:*",
    "@veloce/renderer": "workspace:*",
    "@veloce/server": "workspace:*",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
