{
  "name": "veloce",
  "version": "0.0.0",
  "private": true,
  "description": "AI-first, open-source presentation engine. AI agents build animated decks over MCP; humans edit the same deck by hand.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "tsc -b --clean",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "@veloce/core": "workspace:*",
    "@veloce/format": "workspace:*",
    "@veloce/plugin-api": "workspace:*",
    "@veloce/plugin-image": "workspace:*",
    "@veloce/plugin-shape": "workspace:*",
    "@veloce/plugin-text": "workspace:*",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
