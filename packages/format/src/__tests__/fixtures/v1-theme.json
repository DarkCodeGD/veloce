{
  "name": "Paper",
  "colors": {
    "background": "#fbf8f3",
    "surface": "#f1ebe1",
    "text": "#1d1a16",
    "muted": "#5f574d",
    "border": "#e2d8c8",
    "primary": "#8a3b12",
    "on-primary": "#ffffff",
    "secondary": "#1f5f7a",
    "accent": "#b4235a",
    "success": "#2f7a3b",
    "danger": "#b42318"
  },
  "fonts": {
    "heading": "Fraunces, Georgia, serif",
    "body": "Lora, Georgia, serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace"
  },
  "text": {
    "display": {
      "font": "heading",
      "size": 120,
      "weight": 700,
      "lineHeight": 1.05,
      "letterSpacing": -0.02
    },
    "h1": {
      "font": "heading",
      "size": 80,
      "weight": 650,
      "lineHeight": 1.1,
      "letterSpacing": -0.01
    },
    "h2": {
      "font": "heading",
      "size": 56,
      "weight": 600,
      "lineHeight": 1.15
    },
    "h3": {
      "font": "heading",
      "size": 40,
      "weight": 600,
      "lineHeight": 1.2
    },
    "body": {
      "font": "body",
      "size": 32,
      "weight": 400,
      "lineHeight": 1.5
    },
    "small": {
      "font": "body",
      "size": 24,
      "weight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "font": "body",
      "size": 20,
      "weight": 500,
      "lineHeight": 1.3,
      "letterSpacing": 0.02
    },
    "code": {
      "font": "mono",
      "size": 26,
      "weight": 400,
      "lineHeight": 1.5
    }
  },
  "space": {
    "xs": 8,
    "sm": 16,
    "md": 32,
    "lg": 64,
    "xl": 96,
    "xxl": 160
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 16,
    "full": 9999
  },
  "shadow": {
    "sm": {
      "x": 0,
      "y": 2,
      "blur": 6,
      "color": "#0000001a"
    },
    "md": {
      "x": 0,
      "y": 8,
      "blur": 24,
      "color": "#00000026"
    },
    "lg": {
      "x": 0,
      "y": 24,
      "blur": 64,
      "color": "#00000033"
    }
  }
}
