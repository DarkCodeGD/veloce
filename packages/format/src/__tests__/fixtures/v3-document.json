{
  "id": "v3deck",
  "formatVersion": 3,
  "meta": {
    "title": "A v3 deck"
  },
  "stage": {
    "width": 1920,
    "height": 1080
  },
  "motionLevel": "lively",
  "slides": [
    {
      "id": "s1",
      "motionLevel": "calm",
      "root": {
        "id": "s1-root",
        "kind": "frame",
        "perspective": 1600,
        "layout": {
          "mode": "stack",
          "direction": "column",
          "gap": "$space.md",
          "padding": "$space.xl",
          "justify": "center"
        },
        "children": [
          {
            "id": "title",
            "kind": "element",
            "type": "text",
            "matchKey": "headline",
            "props": {
              "content": "Written by format v3",
              "style": "$text.h1"
            }
          },
          {
            "id": "card",
            "kind": "frame",
            "depth": -400,
            "perspective": 800,
            "layout": {
              "mode": "stack",
              "padding": "$space.lg"
            },
            "style": {
              "fill": "$color.surface"
            },
            "children": [
              {
                "id": "dot",
                "kind": "element",
                "type": "shape",
                "width": 80,
                "height": 80,
                "depth": 120,
                "props": {
                  "shape": "ellipse",
                  "fill": "$color.accent"
                }
              }
            ]
          }
        ]
      },
      "animations": [
        {
          "id": "a-title",
          "target": "title",
          "trigger": "withPrevious",
          "effect": {
            "name": "fade-in",
            "params": {
              "distance": 40
            }
          }
        },
        {
          "id": "a-card",
          "target": "card",
          "trigger": "afterPrevious",
          "delay": "$motion.stagger",
          "duration": "$motion.slow",
          "easing": {
            "spring": {
              "bounce": 0.3
            }
          },
          "tracks": {
            "z": [
              {
                "at": 0,
                "value": -800
              }
            ],
            "opacity": [
              {
                "at": 0,
                "value": 0
              }
            ],
            "style.fill": [
              {
                "at": 0,
                "value": "$color.background"
              },
              {
                "at": 1,
                "value": "$color.surface"
              }
            ]
          }
        },
        {
          "id": "a-dot",
          "target": "dot",
          "duration": 600,
          "easing": {
            "cubicBezier": [0.34, 1.56, 0.64, 1]
          },
          "repeat": "forever",
          "alternate": true,
          "tracks": {
            "scale": [
              {
                "at": 0.5,
                "value": 1.3,
                "easing": "ease-out"
              }
            ],
            "props.fill": [
              {
                "at": 1,
                "value": "$color.primary"
              }
            ]
          }
        },
        {
          "id": "a-shake",
          "target": "title",
          "trigger": "onClick",
          "easing": "$motion.move",
          "repeat": 2,
          "duration": "$motion.fast",
          "tracks": {
            "rotate": [
              {
                "at": 0.5,
                "value": 4
              }
            ]
          }
        }
      ]
    },
    {
      "id": "s2",
      "root": {
        "id": "s2-root",
        "kind": "frame",
        "layout": {
          "mode": "stack"
        },
        "children": [
          {
            "id": "title2",
            "kind": "element",
            "type": "text",
            "matchKey": "headline",
            "props": {
              "content": "Morphs from slide 1",
              "style": "$text.h2"
            }
          }
        ]
      },
      "animations": [
        {
          "id": "a-rise",
          "target": "title2",
          "trigger": "withPrevious",
          "effect": {
            "name": "soft-rise"
          }
        }
      ]
    }
  ],
  "presets": {
    "soft-rise": {
      "title": "Soft rise",
      "description": "A slow, short rise for supporting text.",
      "effect": {
        "name": "fade-in",
        "params": {
          "distance": 40
        }
      },
      "duration": "$motion.slow",
      "easing": "$motion.enter"
    }
  },
  "assets": {}
}
