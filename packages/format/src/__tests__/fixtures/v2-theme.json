{
  "name": "Midnight",
  "colors": {
    "background": "#0a1024",
    "surface": "#141c3a",
    "text": "#eef2ff",
    "muted": "#a5b0d4",
    "border": "#26305a",
    "primary": "#8b6dff",
    "on-primary": "#0a1024",
    "secondary": "#22d3ee",
    "accent": "#f472b6",
    "success": "#34d399",
    "danger": "#fb7185"
  },
  "fonts": {
    "heading": "Inter, system-ui, sans-serif",
    "body": "Inter, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace"
  },
  "text": {
    "display": {
      "font": "heading",
      "size": 120,
      "weight": 900,
      "lineHeight": 1.05,
      "letterSpacing": -0.02
    },
    "h1": {
      "font": "heading",
      "size": 80,
      "weight": 700,
      "lineHeight": 1.1,
      "letterSpacing": -0.01
    },
    "h2": {
      "font": "heading",
      "size": 56,
      "weight": 700,
      "lineHeight": 1.15
    },
    "h3": {
      "font": "heading",
      "size": 40,
      "weight": 600,
      "lineHeight": 1.2
    },
    "lead": {
      "font": "body",
      "size": 48,
      "weight": 400,
      "lineHeight": 1.4
    },
    "body": {
      "font": "body",
      "size": 32,
      "weight": 400,
      "lineHeight": 1.4
    },
    "small": {
      "font": "body",
      "size": 24,
      "weight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "font": "body",
      "size": 20,
      "weight": 600,
      "lineHeight": 1.3,
      "letterSpacing": 0.12,
      "transform": "uppercase"
    },
    "code": {
      "font": "mono",
      "size": 26,
      "weight": 400,
      "lineHeight": 1.5
    }
  },
  "space": {
    "xs": 8,
    "sm": 16,
    "md": 32,
    "lg": 64,
    "xl": 96,
    "xxl": 160
  },
  "radius": {
    "sm": 8,
    "md": 16,
    "lg": 32,
    "full": 9999
  },
  "shadow": {
    "sm": {
      "x": 0,
      "y": 2,
      "blur": 6,
      "color": "#00000066"
    },
    "md": {
      "x": 0,
      "y": 8,
      "blur": 24,
      "color": "#00000080"
    },
    "lg": {
      "x": 0,
      "y": 24,
      "blur": 64,
      "color": "#00000099"
    }
  }
}
