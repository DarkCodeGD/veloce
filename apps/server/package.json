{
  "name": "@veloce/server",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone Node entry point: doc-server + MCP over HTTP (web/dev use).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@veloce/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@veloce/builtins": "workspace:*",
    "@veloce/core": "workspace:*",
    "@veloce/doc-server": "workspace:*",
    "@veloce/mcp": "workspace:*",
    "playwright-core": "1.64.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  },
  "bin": {
    "veloce-server": "./dist/cli.js"
  },
  "scripts": {
    "start": "node dist/cli.js"
  }
}
