{
  "id": "visual-layouts",
  "formatVersion": 2,
  "meta": {
    "title": "Layouts reference"
  },
  "stage": {
    "width": 1920,
    "height": 1080
  },
  "theme": {
    "name": "Paper",
    "colors": {
      "background": "#fbf8f3",
      "surface": "#f1ebe1",
      "text": "#1d1a16",
      "muted": "#5f574d",
      "border": "#e2d8c8",
      "primary": "#8a3b12",
      "on-primary": "#ffffff",
      "secondary": "#1f5f7a",
      "accent": "#b4235a",
      "success": "#2f7a3b",
      "danger": "#b42318"
    },
    "fonts": {
      "heading": "Fraunces, Georgia, serif",
      "body": "Lora, Georgia, serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "text": {
      "display": {
        "font": "heading",
        "size": 120,
        "weight": 700,
        "lineHeight": 1.05,
        "letterSpacing": -0.02
      },
      "h1": {
        "font": "heading",
        "size": 80,
        "weight": 650,
        "lineHeight": 1.1,
        "letterSpacing": -0.01
      },
      "h2": {
        "font": "heading",
        "size": 56,
        "weight": 600,
        "lineHeight": 1.15
      },
      "h3": {
        "font": "heading",
        "size": 40,
        "weight": 600,
        "lineHeight": 1.2
      },
      "lead": {
        "font": "body",
        "size": 48,
        "weight": 400,
        "lineHeight": 1.5
      },
      "body": {
        "font": "body",
        "size": 32,
        "weight": 400,
        "lineHeight": 1.5
      },
      "small": {
        "font": "body",
        "size": 24,
        "weight": 400,
        "lineHeight": 1.4
      },
      "caption": {
        "font": "body",
        "size": 20,
        "weight": 500,
        "lineHeight": 1.3,
        "letterSpacing": 0.02
      },
      "code": {
        "font": "mono",
        "size": 26,
        "weight": 400,
        "lineHeight": 1.5
      }
    },
    "space": {
      "xs": 8,
      "sm": 16,
      "md": 32,
      "lg": 64,
      "xl": 96,
      "xxl": 160
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 16,
      "full": 9999
    },
    "shadow": {
      "sm": {
        "x": 0,
        "y": 2,
        "blur": 6,
        "color": "#0000001a"
      },
      "md": {
        "x": 0,
        "y": 8,
        "blur": 24,
        "color": "#00000026"
      },
      "lg": {
        "x": 0,
        "y": 24,
        "blur": 64,
        "color": "#00000033"
      }
    }
  },
  "slides": [
    {
      "id": "title",
      "hideFooter": true,
      "root": {
        "id": "nd_16env5m8o0",
        "kind": "frame",
        "layout": {
          "mode": "stack",
          "direction": "column",
          "gap": "$space.sm",
          "padding": "$space.xl",
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "id": "title-title",
            "name": "Title",
            "kind": "element",
            "type": "text",
            "props": {
              "content": [
                {
                  "runs": [
                    {
                      "text": "Title",
                      "field": "deckTitle"
                    }
                  ]
                }
              ],
              "style": "$text.display",
              "align": "center"
            }
          },
          {
            "id": "title-subtitle",
            "name": "Subtitle",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "Every built-in layout, in the Paper theme",
              "style": "$text.h3",
              "align": "center",
              "color": "$color.muted"
            }
          }
        ]
      }
    },
    {
      "id": "content",
      "root": {
        "id": "nd_sf99ttz4zg",
        "kind": "frame",
        "layout": {
          "mode": "stack",
          "direction": "column",
          "gap": "$space.lg",
          "padding": "$space.xl",
          "justify": "start"
        },
        "children": [
          {
            "id": "content-title",
            "name": "Title",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "Title and content, with components",
              "style": "$text.h1"
            }
          },
          {
            "id": "content-content",
            "name": "Content",
            "height": "fill",
            "kind": "frame",
            "layout": {
              "mode": "stack",
              "gap": "$space.md"
            },
            "children": [
              {
                "id": "nd_38rnu14234",
                "kind": "frame",
                "layout": {
                  "mode": "stack",
                  "direction": "row",
                  "gap": "$space.md"
                },
                "children": [
                  {
                    "id": "stat-card",
                    "width": "fill",
                    "kind": "frame",
                    "layout": {
                      "mode": "stack",
                      "gap": "$space.xs",
                      "padding": "$space.lg"
                    },
                    "style": {
                      "fill": "$color.surface",
                      "radius": "$radius.md",
                      "shadow": "$shadow.sm"
                    },
                    "children": [
                      {
                        "id": "stat-card-value",
                        "kind": "element",
                        "type": "text",
                        "props": {
                          "content": "48%",
                          "style": "$text.h1",
                          "color": "$color.primary"
                        }
                      },
                      {
                        "id": "stat-card-label",
                        "kind": "element",
                        "type": "text",
                        "props": {
                          "content": "Faster builds",
                          "style": "$text.body"
                        }
                      }
                    ]
                  },
                  {
                    "id": "stat-card-2",
                    "width": "fill",
                    "kind": "frame",
                    "layout": {
                      "mode": "stack",
                      "gap": "$space.xs",
                      "padding": "$space.lg"
                    },
                    "style": {
                      "fill": "$color.surface",
                      "radius": "$radius.md",
                      "shadow": "$shadow.sm"
                    },
                    "children": [
                      {
                        "id": "stat-card-2-value",
                        "kind": "element",
                        "type": "text",
                        "props": {
                          "content": "3×",
                          "style": "$text.h1",
                          "color": "$color.primary"
                        }
                      },
                      {
                        "id": "stat-card-2-label",
                        "kind": "element",
                        "type": "text",
                        "props": {
                          "content": "More decks",
                          "style": "$text.body"
                        }
                      }
                    ]
                  },
                  {
                    "id": "stat-card-3",
                    "width": "fill",
                    "kind": "frame",
                    "layout": {
                      "mode": "stack",
                      "gap": "$space.xs",
                      "padding": "$space.lg"
                    },
                    "style": {
                      "fill": "$color.surface",
                      "radius": "$radius.md",
                      "shadow": "$shadow.sm"
                    },
                    "children": [
                      {
                        "id": "stat-card-3-value",
                        "kind": "element",
                        "type": "text",
                        "props": {
                          "content": "0",
                          "style": "$text.h1",
                          "color": "$color.primary"
                        }
                      },
                      {
                        "id": "stat-card-3-label",
                        "kind": "element",
                        "type": "text",
                        "props": {
                          "content": "Lost edits",
                          "style": "$text.body"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "columns",
      "root": {
        "id": "nd_y9eimqxela",
        "kind": "frame",
        "layout": {
          "mode": "stack",
          "direction": "column",
          "gap": "$space.lg",
          "padding": "$space.xl",
          "justify": "start"
        },
        "children": [
          {
            "id": "columns-title",
            "name": "Title",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "Two columns",
              "style": "$text.h1"
            }
          },
          {
            "id": "columns-columns",
            "name": "Columns",
            "height": "fill",
            "kind": "frame",
            "layout": {
              "mode": "grid",
              "columns": 2,
              "gap": "$space.lg"
            },
            "children": [
              {
                "id": "columns-left",
                "name": "Left",
                "kind": "element",
                "type": "text",
                "props": {
                  "content": "The left column sets its text in the lead style, so it fills the slide.",
                  "style": "$text.lead"
                }
              },
              {
                "id": "columns-right",
                "name": "Right",
                "kind": "element",
                "type": "text",
                "props": {
                  "content": "The right column does the same, side by side with the left one.",
                  "style": "$text.lead"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "section",
      "background": "$color.primary",
      "section": "Results",
      "hideFooter": true,
      "root": {
        "id": "nd_ejnl53l8dy",
        "kind": "frame",
        "layout": {
          "mode": "stack",
          "direction": "column",
          "gap": "$space.sm",
          "padding": "$space.xl",
          "justify": "center"
        },
        "children": [
          {
            "id": "section-title",
            "name": "Title",
            "kind": "element",
            "type": "text",
            "props": {
              "content": [
                {
                  "runs": [
                    {
                      "text": "Section",
                      "field": "section"
                    }
                  ]
                }
              ],
              "style": "$text.h1",
              "color": "$color.on-primary"
            }
          },
          {
            "id": "section-subtitle",
            "name": "Subtitle",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "What we found",
              "style": "$text.h3",
              "color": "$color.on-primary"
            }
          }
        ]
      }
    },
    {
      "id": "number",
      "root": {
        "id": "nd_dnjk1rz0ka",
        "kind": "frame",
        "layout": {
          "mode": "stack",
          "direction": "column",
          "gap": "$space.sm",
          "padding": "$space.xl",
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "id": "number-number",
            "name": "Number",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "42%",
              "style": "$text.display",
              "align": "center",
              "color": "$color.primary"
            }
          },
          {
            "id": "number-caption",
            "name": "Caption",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "of the work was layout",
              "style": "$text.h3",
              "align": "center"
            }
          }
        ]
      }
    },
    {
      "id": "quote",
      "root": {
        "id": "nd_mlhnkf8mw2",
        "kind": "frame",
        "layout": {
          "mode": "stack",
          "direction": "column",
          "gap": "$space.md",
          "padding": "$space.xl",
          "justify": "center"
        },
        "children": [
          {
            "id": "quote-quote",
            "name": "Quote",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "“Describe the structure; let the engine do the pixels.”",
              "style": "$text.h2"
            }
          },
          {
            "id": "quote-author",
            "name": "Author",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "Veloce",
              "style": "$text.body",
              "color": "$color.muted"
            }
          }
        ]
      }
    }
  ],
  "assets": {},
  "components": {
    "Stat card": {
      "description": "A number and what it means",
      "params": {
        "value": {
          "targets": ["card-value.props.content"]
        },
        "label": {
          "targets": ["card-label.props.content"]
        }
      },
      "node": {
        "id": "card",
        "width": "fill",
        "kind": "frame",
        "layout": {
          "mode": "stack",
          "gap": "$space.xs",
          "padding": "$space.lg"
        },
        "style": {
          "fill": "$color.surface",
          "radius": "$radius.md",
          "shadow": "$shadow.sm"
        },
        "children": [
          {
            "id": "card-value",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "0",
              "style": "$text.h1",
              "color": "$color.primary"
            }
          },
          {
            "id": "card-label",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "Label",
              "style": "$text.body"
            }
          }
        ]
      }
    }
  }
}
