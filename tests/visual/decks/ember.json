{
  "id": "visual-ember",
  "formatVersion": 2,
  "meta": {
    "title": "Ember reference"
  },
  "stage": {
    "width": 1920,
    "height": 1080
  },
  "theme": {
    "name": "Ember",
    "colors": {
      "background": "#fffaf5",
      "surface": "#fbeee2",
      "text": "#1f1612",
      "muted": "#6f5d52",
      "border": "#efd9c6",
      "primary": "#c2410c",
      "on-primary": "#ffffff",
      "secondary": "#0f766e",
      "accent": "#db2777",
      "success": "#15803d",
      "danger": "#b91c1c"
    },
    "fonts": {
      "heading": "Inter, system-ui, sans-serif",
      "body": "Inter, system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "text": {
      "display": {
        "font": "heading",
        "size": 120,
        "weight": 800,
        "lineHeight": 1.05,
        "letterSpacing": -0.02
      },
      "h1": {
        "font": "heading",
        "size": 80,
        "weight": 700,
        "lineHeight": 1.1,
        "letterSpacing": -0.01
      },
      "h2": {
        "font": "heading",
        "size": 56,
        "weight": 700,
        "lineHeight": 1.15
      },
      "h3": {
        "font": "heading",
        "size": 40,
        "weight": 600,
        "lineHeight": 1.2
      },
      "lead": {
        "font": "body",
        "size": 48,
        "weight": 400,
        "lineHeight": 1.4
      },
      "body": {
        "font": "body",
        "size": 32,
        "weight": 400,
        "lineHeight": 1.4
      },
      "small": {
        "font": "body",
        "size": 24,
        "weight": 400,
        "lineHeight": 1.4
      },
      "caption": {
        "font": "body",
        "size": 20,
        "weight": 500,
        "lineHeight": 1.3,
        "letterSpacing": 0.02
      },
      "code": {
        "font": "mono",
        "size": 26,
        "weight": 400,
        "lineHeight": 1.5
      }
    },
    "space": {
      "xs": 8,
      "sm": 16,
      "md": 32,
      "lg": 64,
      "xl": 96,
      "xxl": 160
    },
    "radius": {
      "sm": 6,
      "md": 12,
      "lg": 24,
      "full": 9999
    },
    "shadow": {
      "sm": {
        "x": 0,
        "y": 2,
        "blur": 6,
        "color": "#0000001a"
      },
      "md": {
        "x": 0,
        "y": 8,
        "blur": 24,
        "color": "#00000026"
      },
      "lg": {
        "x": 0,
        "y": 24,
        "blur": 64,
        "color": "#00000033"
      }
    }
  },
  "slides": [
    {
      "id": "mixed",
      "root": {
        "id": "nd_e24acx47ns",
        "kind": "frame",
        "layout": {
          "mode": "stack",
          "gap": "$space.lg",
          "padding": "$space.xl",
          "justify": "center"
        },
        "children": [
          {
            "id": "nd_oenmp4nz0e",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "Launch plan",
              "style": "$text.display"
            }
          },
          {
            "id": "nd_cskefnc2tt",
            "kind": "element",
            "type": "text",
            "props": {
              "content": "Three steps, one quarter",
              "style": "$text.lead",
              "color": "$color.muted"
            }
          },
          {
            "id": "nd_bpdl1kpcn9",
            "kind": "frame",
            "layout": {
              "mode": "grid",
              "columns": 3,
              "gap": "$space.md"
            },
            "children": [
              {
                "id": "nd_wfjfxid68p",
                "kind": "frame",
                "layout": {
                  "mode": "stack",
                  "gap": "$space.sm",
                  "padding": "$space.lg"
                },
                "style": {
                  "fill": "$color.surface",
                  "radius": "$radius.md"
                },
                "children": [
                  {
                    "id": "nd_gevqvzv35h",
                    "kind": "element",
                    "type": "text",
                    "props": {
                      "content": "01",
                      "style": "$text.caption",
                      "color": "$color.accent"
                    }
                  },
                  {
                    "id": "nd_2wm2vadpvc",
                    "kind": "element",
                    "type": "text",
                    "props": {
                      "content": "Design",
                      "style": "$text.h2"
                    }
                  }
                ]
              },
              {
                "id": "nd_2hgauncpda",
                "kind": "frame",
                "layout": {
                  "mode": "stack",
                  "gap": "$space.sm",
                  "padding": "$space.lg"
                },
                "style": {
                  "fill": "$color.primary",
                  "radius": "$radius.md"
                },
                "children": [
                  {
                    "id": "nd_6e275dwq6p",
                    "kind": "element",
                    "type": "text",
                    "props": {
                      "content": "02",
                      "style": "$text.caption",
                      "color": "$color.background"
                    }
                  },
                  {
                    "id": "nd_xye1qljhm2",
                    "kind": "element",
                    "type": "text",
                    "props": {
                      "content": "Build",
                      "style": "$text.h2",
                      "color": "$color.background"
                    }
                  }
                ]
              },
              {
                "id": "nd_yda34kh305",
                "kind": "frame",
                "layout": {
                  "mode": "stack",
                  "gap": "$space.sm",
                  "padding": "$space.lg"
                },
                "style": {
                  "fill": "$color.surface",
                  "radius": "$radius.md"
                },
                "children": [
                  {
                    "id": "nd_5fq3lipiqi",
                    "kind": "element",
                    "type": "text",
                    "props": {
                      "content": "03",
                      "style": "$text.caption",
                      "color": "$color.accent"
                    }
                  },
                  {
                    "id": "nd_zp40s8tdpe",
                    "kind": "element",
                    "type": "text",
                    "props": {
                      "content": "Ship",
                      "style": "$text.h2"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "assets": {}
}
