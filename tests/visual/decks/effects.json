    "space": {
      "xs": 8,
      "sm": 16,
      "md": 32,
      "lg": 64,
      "xl": 96,
      "xxl": 160
    },
    "radius": {
      "sm": 8,
      "md": 16,
      "lg": 32,
      "full": 9999
    },
    "shadow": {
      "sm": {
        "x": 0,
        "y": 2,
        "blur": 6,
        "color": "#0000001a"
      },
      "md": {
        "x": 0,
        "y": 8,
        "blur": 24,
        "color": "#00000026"
      },
      "lg": {
        "x": 0,
        "y": 24,
        "blur": 64,
        "color": "#00000033"
      }
    },
    "motion": {
      "fast": 200,
      "normal": 400,
      "slow": 700,
      "stagger": 80,
      "enter": {
        "cubicBezier": [0.16, 1, 0.3, 1]
      },
      "exit": {
        "cubicBezier": [0.7, 0, 0.84, 0]
      },
      "move": {
        "cubicBezier": [0.65, 0, 0.35, 1]
      }
    }
